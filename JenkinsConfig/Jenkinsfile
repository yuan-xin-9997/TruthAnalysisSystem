pipeline {
    agent any

    triggers {
        pollSCM('H/3 * * * *')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        DEPLOY_DIR = '/opt/TruthAnalysisSystem'
        APP_DIR = '/opt/TruthAnalysisSystem/src_gpt5.5'
    }

    stages {
        stage('Checkout from GitHub') {
            steps {
                checkout scm
            }
        }

        stage('Stop Service') {
            steps {
                sh '''
                    set -eu
                    if [ -f "$APP_DIR/stop.sh" ]; then
                        chmod +x "$APP_DIR/stop.sh"
                        "$APP_DIR/stop.sh"
                    else
                        echo "No deployed stop.sh found; treating this as the first deployment."
                    fi
                '''
            }
        }

        stage('Update Deployment') {
            steps {
                sh '''
                    set -eu
                    mkdir -p "$DEPLOY_DIR"
                    rsync -a --delete \
                        --exclude='.git/' \
                        --exclude='.env' \
                        --exclude='src_gpt5.5/config/app.json' \
                        --exclude='src_gpt5.5/data/' \
                        --exclude='src_gpt5.5/logs/' \
                        "$WORKSPACE/" "$DEPLOY_DIR/"
                    if [ ! -f "$APP_DIR/config/app.json" ]; then
                        cp "$WORKSPACE/src_gpt5.5/config/app.json" "$APP_DIR/config/app.json"
                    fi
                '''
            }
        }

        stage('Start Service') {
            steps {
                sh '''
                    set -eu
                    test -f "$APP_DIR/start.sh"
                    chmod +x "$APP_DIR/start.sh"
                    [ ! -f "$APP_DIR/stop.sh" ] || chmod +x "$APP_DIR/stop.sh"
                    [ ! -f "$APP_DIR/status.sh" ] || chmod +x "$APP_DIR/status.sh"
                    "$APP_DIR/start.sh"
                '''
            }
        }
    }

    post {
        success {
            echo 'TruthAnalysisSystem deployment completed successfully.'
        }
        failure {
            echo 'TruthAnalysisSystem deployment failed. Check the Jenkins console log.'
        }
    }
}
