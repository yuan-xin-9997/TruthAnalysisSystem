{
  "app": {
    "host": "0.0.0.0",
    "port": 8000,
    "timezone": "Asia/Shanghai"
  },
  "paths": {
    "content_root": ".."
  },
  "crawler": {
    "enabled": true,
    "progress_file": "data/已抓取.md",
    "base_url": "https://trumpstruth.org/statuses",
    "batch_size": 100,
    "daily_time": "22:30",
    "request_timeout_seconds": 20,
    "request_delay_seconds": 0.1,
    "max_workers": 4,
    "max_retries": 3,
    "download_attachments": true,
    "translate_to_chinese": true
  },
  "analysis": {
    "enable_llm": true,
    "openai_model": "gpt-5.5",
    "prompt_version": "v1",
    "cache_llm_results": true,
    "china_relevance_min_keyword_hits": 1,
    "china_relevance_min_score": 0.22,
    "china_relevance_keywords": [
      "china",
      "chinese",
      "ccp",
      "beijing",
      "xi",
      "taiwan",
      "hong kong"
    ],
    "china_relevance_excluded_keywords": [
      "tariff",
      "tiktok",
      "trade war",
      "communist",
      "communists"
    ]
  },
  "market": {
    "enabled": true,
    "daily_sync_time": "07:00",
    "symbols": ["SPY", "QQQ", "DIA"],
    "prediction_horizons": [1, 3, 5],
    "transaction_cost_bps": 5,
    "provider": "stooq"
  },
  "scheduler": {
    "enabled": true,
    "run_on_startup": false
  },
  "notification": {
    "enabled": false,
    "send_after_daily_crawl": false,
    "min_china_related_count": 1,
    "smtp_host": "",
    "smtp_port": 587,
    "smtp_username": "",
    "smtp_password": "",
    "smtp_use_tls": true,
    "sender": "",
    "recipient": "",
    "subject_prefix": "[特朗普真实社交]"
  }
